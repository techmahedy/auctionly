APP_NAME=Auctionly
APP_KEY=base64:generate-a-unique-32-byte-key-before-deploying
APP_URL=https://auctionly.example.com
SERVER_NAME=auctionly.example.com
ACME_EMAIL=admin@example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_ROUTE_CACHE=true

MYSQL_DATABASE=auctionly
MYSQL_USER=auctionly
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=auctionly
DB_USERNAME=auctionly
DB_PASSWORD=replace-with-a-long-random-password

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Auctionly
CONTACT_TO_ADDRESS=contact@example.com

LOG_CHANNEL=stack
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
